<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="facture" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- ===== PARAMÈTRES (depuis ton Order) ===== -->
    <parameter name="orderNumber"    class="java.lang.String"/>
    <parameter name="createdAt"      class="java.lang.String"/>
    <parameter name="status"         class="java.lang.String"/>
    <parameter name="clientFullName" class="java.lang.String"/>
    <parameter name="clientEmail"    class="java.lang.String"/>
    <parameter name="clientPhone"    class="java.lang.String"/>
    <parameter name="shippingAddress" class="java.lang.String"/>
    <parameter name="shippingCity"   class="java.lang.String"/>
    <parameter name="shippingZip"    class="java.lang.String"/>
    <parameter name="shippingCountry" class="java.lang.String"/>
    <parameter name="subtotal"       class="java.lang.String"/>
    <parameter name="shippingCost"   class="java.lang.String"/>
    <parameter name="discountAmount" class="java.lang.String"/>
    <parameter name="promoCode"      class="java.lang.String"/>
    <parameter name="total"          class="java.lang.String"/>

    <!-- ===== CHAMPS (depuis OrderItem) ===== -->
    <field name="productName"  class="java.lang.String"/>
    <field name="selectedSize" class="java.lang.String"/>
    <field name="selectedColor" class="java.lang.String"/>
    <field name="quantity"     class="java.lang.Integer"/>
    <field name="unitPrice"    class="java.lang.String"/>
    <field name="totalPrice"   class="java.lang.String"/>

    <!-- ===== EN-TÊTE ===== -->
    <title>
        <band height="100">
            <!-- Nom de la boutique -->
            <staticText>
                <reportElement x="0" y="0" width="300" height="40"/>
                <textElement><font size="24" isBold="true"/></textElement>
                <text><![CDATA[MosilShop]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="40" width="300" height="20"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Votre boutique en ligne de confiance]]></text>
            </staticText>
            <!-- Titre FACTURE -->
            <staticText>
                <reportElement x="355" y="0" width="200" height="40"/>
                <textElement textAlignment="Right"><font size="28" isBold="true"/></textElement>
                <text><![CDATA[FACTURE]]></text>
            </staticText>
            <!-- Numéro de commande -->
            <textField>
                <reportElement x="355" y="40" width="200" height="20"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["N° " + $P{orderNumber}]]></textFieldExpression>
            </textField>
            <!-- Date -->
            <textField>
                <reportElement x="355" y="60" width="200" height="20"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Date : " + $P{createdAt}]]></textFieldExpression>
            </textField>
            <!-- Statut -->
            <textField>
                <reportElement x="355" y="80" width="200" height="20"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Statut : " + $P{status}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ===== INFO CLIENT + LIVRAISON ===== -->
    <pageHeader>
        <band height="110">
            <!-- Bloc Client -->
            <staticText>
                <reportElement x="0" y="0" width="250" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[FACTURER À]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="20" width="250" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{clientFullName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="38" width="250" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{clientEmail}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="56" width="250" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{clientPhone}]]></textFieldExpression>
            </textField>

            <!-- Bloc Livraison -->
            <staticText>
                <reportElement x="300" y="0" width="255" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[LIVRER À]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="20" width="255" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{shippingAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="38" width="255" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{shippingZip} + " " + $P{shippingCity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="56" width="255" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{shippingCountry}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ===== EN-TÊTE DU TABLEAU ===== -->
    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#2C3E50" forecolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5"   y="4" width="200" height="18" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Produit]]></text>
            </staticText>
            <staticText>
                <reportElement x="205" y="4" width="80"  height="18" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Taille/Couleur]]></text>
            </staticText>
            <staticText>
                <reportElement x="295" y="4" width="60"  height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Qté]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="4" width="95"  height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Prix unitaire]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="4" width="90"  height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ===== LIGNES DU TABLEAU ===== -->
    <detail>
        <band height="22" splitType="Stretch">
            <textField>
                <reportElement x="5"   y="3" width="200" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="205" y="3" width="80"  height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[($F{selectedSize} != null ? $F{selectedSize} : "") + " " + ($F{selectedColor} != null ? $F{selectedColor} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="295" y="3" width="60"  height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="3" width="95"  height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{unitPrice} + " FCFA"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="460" y="3" width="90"  height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalPrice} + " FCFA"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ===== TOTAUX ===== -->
    <summary>
        <band height="140">
            <!-- Ligne séparatrice -->
            <line>
                <reportElement x="300" y="5" width="255" height="1"/>
            </line>
            <!-- Sous-total -->
            <staticText>
                <reportElement x="300" y="12" width="155" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <text><![CDATA[Sous-total :]]></text>
            </staticText>
            <textField>
                <reportElement x="460" y="12" width="90" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{subtotal} + " FCFA"]]></textFieldExpression>
            </textField>
            <!-- Frais de livraison -->
            <staticText>
                <reportElement x="300" y="32" width="155" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <text><![CDATA[Frais de livraison :]]></text>
            </staticText>
            <textField>
                <reportElement x="460" y="32" width="90" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{shippingCost} + " FCFA"]]></textFieldExpression>
            </textField>
            <!-- Réduction (si promo) -->
            <staticText>
                <reportElement x="300" y="52" width="155" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <text><![CDATA[Réduction :]]></text>
            </staticText>
            <textField>
                <reportElement x="460" y="52" width="90" height="18"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["- " + $P{discountAmount} + " FCFA" + ($P{promoCode} != null && !$P{promoCode}.isEmpty() ? " (" + $P{promoCode} + ")" : "")]]></textFieldExpression>
            </textField>
            <!-- Total final -->
            <rectangle>
                <reportElement x="300" y="76" width="255" height="28" backcolor="#2C3E50" forecolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="305" y="80" width="150" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[TOTAL :]]></text>
            </staticText>
            <textField>
                <reportElement x="455" y="80" width="95" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{total} + " FCFA"]]></textFieldExpression>
            </textField>
            <!-- Merci -->
            <staticText>
                <reportElement x="0" y="110" width="555" height="18"/>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[Merci pour votre commande sur MosilShop !]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>